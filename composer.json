{
    "name": "donatj/cli-toolkit",
    "type": "library",
    "description": "Simple PHP CLI Toolkit",
    "keywords": ["CLI-Toolkit", "CLI"],
    "homepage": "https://github.com/donatj/CLI-Toolkit",
    "license": "MIT",
    "require": {
        "php": ">=7.4.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "authors": [
        {
            "name": "Jesse G. Donat",
            "email": "donatj@gmail.com",
            "homepage": "https://donatstudios.com",
            "role": "Developer"
        }
    ],
    "autoload": {
        "psr-4": {
            "CLI\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
